<Window x:Class="Authorization.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Authorization"
        mc:Ignorable="d"
        Title="Авторизация" Height="440" Width="400">
    <StackPanel>
        <TabControl>
            <TabItem Header="Авторизация">
                <StackPanel Margin="40 10">
                    <Label Content="Авторизация" FontSize="30" HorizontalAlignment="Center" Margin="0 50 0 20"/>
                    <Label Content="Логин"/>
                    <TextBox Name="LoginField"/>
                    <Label Content="Пароль"/>
                    <TextBox Name="PasswordField"/>
                    
                    <Button VerticalAlignment="Bottom" Click="LoginBtn_Click" Content="Войти" Margin="30"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Регистрация">
                <StackPanel Margin="40 10">
                    <Label Content="Регистрация" FontSize="30" HorizontalAlignment="Center" Margin="0 50 0 20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">
                            <Label Content="Фамилия"/>
                            <TextBox Name="SurnameField"/>
                            <Label Content="Имя"/>
                            <TextBox Name="NameField"/>
                            <Label Content="Отчество"/>
                            <TextBox Name="PatronymicField"/>
                            <Label Content="Телефон"/>
                            <TextBox Name="PhoneField"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10 0 0 0">
                            <Label Content="Почта"/>
                            <TextBox Name="emailField"/>
                            <Label Content="Логин"/>
                            <TextBox Name="RegLoginField"/>
                            <Label Content="Пароль"/>
                            <TextBox Name="RegPasswordField"/>
                            <Label Content="Подтверждение пароля"/>
                            <TextBox Name="PasswordApplyField"/>
                        </StackPanel>
                    </Grid>
                    <Button VerticalAlignment="Bottom" Click="RegisterBtn_Click" Content="Зарегистрироваться" Margin="30"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</Window>
